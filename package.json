{
  "name": "@local/firmware-finder",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "通过 /cpfirmware 斜杠命令按机型/系统查 Teambition 发版看板归档字段里的量产固件",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "command.js",
    "login.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "tools/*",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
